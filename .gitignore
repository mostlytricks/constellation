# venv + bytecode
.venv/
__pycache__/

# PRIVACY WALL — this repo is public.
# Real decks and their extracted text must never be committed.
# Only generalized templates (no source text) may graduate to library/templates/.
fixtures/*.pptx
library/analysis/*
# ...except the synthetic fixture's output — the committed worked example.
# (orion-sample is generated by fixtures/make_fixture.py; no real content.)
# Note the `*` above: excluding the dir itself would stop git descending,
# making this re-include dead (gitignore parent-dir rule).
!library/analysis/orion-sample/

# Rendered decks are regenerable binaries — the committed deck-spec.json is
# the source. (A deck from a *private* brief keeps spec AND pptx out of git.)
library/decks/*/*.pptx
